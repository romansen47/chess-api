<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>demo.chess</groupId>
    <artifactId>chess-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>chess-api</name>
    <description>REST API for chess frontend</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- REST / JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Chess Core -->
        <dependency>
            <groupId>demo.chess</groupId>
            <artifactId>chess</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Embedded Chess Database -->
        <dependency>
            <groupId>demo.chess</groupId>
            <artifactId>chess-database</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>

        <finalName>chess-app</finalName>

        <resources>

            <!-- Normale Backend-Ressourcen -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>

            <!-- Produktionsbuild des React/Vite-Frontends -->
            <resource>
                <directory>${project.basedir}/../chess-frontend/dist</directory>
                <targetPath>static</targetPath>
            </resource>

        </resources>

        <plugins>

            <!--
                Das Frontend bleibt ein normales npm/Vite-Projekt.
                Maven startet lediglich dessen Release-Build, bevor
                die Ressourcen des Backends verarbeitet werden.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.3</version>

                <executions>

                    <execution>
                        <id>frontend-npm-ci</id>
                        <phase>generate-resources</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <workingDirectory>
                                ${project.basedir}/../chess-frontend
                            </workingDirectory>

                            <executable>npm</executable>

                            <arguments>
                                <argument>ci</argument>
                            </arguments>
                        </configuration>
                    </execution>

                    <execution>
                        <id>frontend-build</id>
                        <phase>generate-resources</phase>

                        <goals>
                            <goal>exec</goal>
                        </goals>

                        <configuration>
                            <workingDirectory>
                                ${project.basedir}/../chess-frontend
                            </workingDirectory>

                            <executable>npm</executable>

                            <arguments>
                                <argument>run</argument>
                                <argument>build</argument>
                            </arguments>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>

    </build>

</project>
